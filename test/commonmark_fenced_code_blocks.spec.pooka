test "CommonMark 140: Fenced code blocks" {
  let source = "foo\n```\nbar\n```\nbaz\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n"
  )
}

test "CommonMark 141: Fenced code blocks" {
  let source = "foo\n---\n~~~\nbar\n~~~\n# baz\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<h2>foo</h2>\n<pre><code>bar\n</code></pre>\n<h1>baz</h1>\n"
  )
}

test "CommonMark 142: Fenced code blocks" {
  let source = "```ruby\ndef foo(x)\n  return 3\nend\n```\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n"
  )
}

test "CommonMark 143: Fenced code blocks" {
  let source = "~~~~    ruby startline=3 $%@#$\ndef foo(x)\n  return 3\nend\n~~~~~~~\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n"
  )
}

test "CommonMark 144: Fenced code blocks" {
  let source = "````;\n````\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<pre><code class=\"language-;\"></code></pre>\n")
}

test "CommonMark 145: Fenced code blocks" {
  let source = "``` aa ```\nfoo\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><code>aa</code>\nfoo</p>\n")
}

test "CommonMark 146: Fenced code blocks" {
  let source = "~~~ aa ``` ~~~\nfoo\n~~~\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<pre><code class=\"language-aa\">foo\n</code></pre>\n")
}

test "CommonMark 147: Fenced code blocks" {
  let source = "```\n``` aaa\n```\n"
