// Cases from CommonMark 0.31.2. The upstream expected HTML is unchanged.
// Skipped cases are known gaps, not accepted variations of the standard.
module commonmark_fenced_code_blocks_test

import marksy
import marksy/html
import poke/should

test "CommonMark 119: Fenced code blocks" {
  let source = "```\n<\n >\n```\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<pre><code>&lt;\n &gt;\n</code></pre>\n")
}

test "CommonMark 120: Fenced code blocks" {
  let source = "~~~\n<\n >\n~~~\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<pre><code>&lt;\n &gt;\n</code></pre>\n")
}

test "CommonMark 121: Fenced code blocks" {
  let source = "``\nfoo\n``\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><code>foo</code></p>\n")
}

