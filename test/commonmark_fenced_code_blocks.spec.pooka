test "CommonMark 127: Fenced code blocks" {
  let source = "`````\n\n```\naaa\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<pre><code>\n```\naaa\n</code></pre>\n")
}

test "CommonMark 128: Fenced code blocks" {
  let source = "> ```\n> aaa\n\nbbb\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<blockquote>\n<pre><code>aaa\n</code></pre>\n</blockquote>\n<p>bbb</p>\n"
  )
}

