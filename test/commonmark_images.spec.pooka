test "CommonMark 590: Images" {
  let source = "![[foo]]\n\n[[foo]]: /url \"title\"\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p>![[foo]]</p>\n<p>[[foo]]: /url &quot;title&quot;</p>\n"
  )
}

test "CommonMark 591: Images" {
  let source = "![Foo]\n\n[foo]: /url \"title\"\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>\n"
  )
}

test "CommonMark 592: Images" {
  let source = "!\\[foo]\n\n[foo]: /url \"title\"\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>![foo]</p>\n")
}

test "CommonMark 593: Images" {
  let source = "\\![foo]\n\n[foo]: /url \"title\"\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>!<a href=\"/url\" title=\"title\">foo</a></p>\n")
}
