test "CommonMark 587: Images" {
  let source = "![foo] \n[]\n\n[foo]: /url \"title\"\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><img src=\"/url\" alt=\"foo\" title=\"title\" />\n[]</p>\n"
