// Cases from CommonMark 0.31.2. The upstream expected HTML is unchanged.
// Skipped cases are known gaps, not accepted variations of the standard.
module commonmark_list_items_test

import marksy
import marksy/html
import poke/should

test "CommonMark 253: List items" {
  let source = "A paragraph\nwith two lines.\n\n    indented code\n\n> A block quote.\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n"
  )
}

test "CommonMark 254: List items" {
  let source = "1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n"
  )
}

test "CommonMark 255: List items" {
  let source = "- one\n\n two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n")
}

test "CommonMark 256: List items" {
  let source = "- one\n\n  two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")
}

test "CommonMark 257: List items" {
  let source = " -    one\n\n     two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<ul>\n<li>one</li>\n</ul>\n<pre><code> two\n</code></pre>\n"
  )
}

test "CommonMark 258: List items" {
  let source = " -    one\n\n      two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")
}

test "CommonMark 259: List items" {
  let source = "   > > 1.  one\n>>\n>>     two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<blockquote>\n<blockquote>\n<ol>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ol>\n</blockquote>\n</blockquote>\n"
  )
}

test "CommonMark 260: List items" {
  let source = ">>- one\n>>\n  >  > two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<blockquote>\n<blockquote>\n<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n</blockquote>\n</blockquote>\n"
  )
}

test "CommonMark 261: List items" {
  let source = "-one\n\n2.two\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>-one</p>\n<p>2.two</p>\n")
}

test "CommonMark 262: List items" {
  let source = "- foo\n\n\n  bar\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
