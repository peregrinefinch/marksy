test "CommonMark 265: List items" {
  let source = "123456789. ok\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<ol start=\"123456789\">\n<li>ok</li>\n</ol>\n")
}

test "CommonMark 266: List items" {
  let source = "1234567890. not ok\n"
