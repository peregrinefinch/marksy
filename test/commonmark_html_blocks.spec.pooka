test "CommonMark 152: HTML blocks" {
  let source = "<DIV CLASS=\"foo\">\n\n*Markdown*\n\n</DIV>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<DIV CLASS=\"foo\">\n<p><em>Markdown</em></p>\n</DIV>\n"
  )
}

