}

test "CommonMark 172: HTML blocks" {
  let source = "<style\n  type=\"text/css\">\nh1 {color:red;}\n\np {color:blue;}\n</style>\nokay\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<style\n  type=\"text/css\">\nh1 {color:red;}\n\np {color:blue;}\n</style>\n<p>okay</p>\n"
  )
}

test "CommonMark 173: HTML blocks" {
  let source = "<style\n  type=\"text/css\">\n\nfoo\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<style\n  type=\"text/css\">\n\nfoo\n")
}

test "CommonMark 174: HTML blocks" {
  let source = "> <div>\n> foo\n\nbar\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<blockquote>\n<div>\nfoo\n</blockquote>\n<p>bar</p>\n")
}

test "CommonMark 175: HTML blocks" {
  let source = "- <div>\n- foo\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<ul>\n<li>\n<div>\n</li>\n<li>foo</li>\n</ul>\n")
}

test "CommonMark 176: HTML blocks" {
  let source = "<style>p{color:red;}</style>\n*foo*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<style>p{color:red;}</style>\n<p><em>foo</em></p>\n")
}

test "CommonMark 177: HTML blocks" {
  let source = "<!-- foo -->*bar*\n*baz*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<!-- foo -->*bar*\n<p><em>baz</em></p>\n")
}

test "CommonMark 178: HTML blocks" {
  let source = "<script>\nfoo\n</script>1. *bar*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<script>\nfoo\n</script>1. *bar*\n")
