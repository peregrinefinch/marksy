  should.equal(actual, "<!-- Foo\n\nbar\n   baz -->\n<p>okay</p>\n")
}

test "CommonMark 180: HTML blocks" {
  let source = "<?php\n\n  echo '>';\n\n?>\nokay\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<?php\n\n  echo '>';\n\n?>\n<p>okay</p>\n")
}

test "CommonMark 181: HTML blocks" {
  let source = "<!DOCTYPE html>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<!DOCTYPE html>\n")
}

test "CommonMark 182: HTML blocks" {
  let source = "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) then {\n    return 1;\n\n  } else {\n\n    return 0;\n  }\n}\n]]>\nokay\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) then {\n    return 1;\n\n  } else {\n\n    return 0;\n  }\n}\n]]>\n<p>okay</p>\n"
  )
}

test "CommonMark 183: HTML blocks" {
  let source = "  <!-- foo -->\n\n    <!-- foo -->\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "  <!-- foo -->\n<pre><code>&lt;!-- foo --&gt;\n</code></pre>\n"
  )
}

test "CommonMark 184: HTML blocks" {
  let source = "  <div>\n\n    <div>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "  <div>\n<pre><code>&lt;div&gt;\n</code></pre>\n")
}

test "CommonMark 185: HTML blocks" {
  let source = "Foo\n<div>\nbar\n</div>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>Foo</p>\n<div>\nbar\n</div>\n")
}

test "CommonMark 186: HTML blocks" {
  let source = "<div>\nbar\n</div>\n*foo*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<div>\nbar\n</div>\n*foo*\n")
}

test "CommonMark 187: HTML blocks" {
  let source = "Foo\n<a href=\"bar\">\nbaz\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>Foo\n<a href=\"bar\">\nbaz</p>\n")
}

test "CommonMark 188: HTML blocks" {
  let source = "<div>\n\n*Emphasized* text.\n\n</div>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<div>\n<p><em>Emphasized</em> text.</p>\n</div>\n")
}

test "CommonMark 189: HTML blocks" {
  let source = "<div>\n*Emphasized* text.\n</div>\n"
