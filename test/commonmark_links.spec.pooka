// SPDX-License-Identifier: CC-BY-SA-4.0

// Cases from CommonMark 0.31.2. The upstream expected HTML is unchanged.
// Skipped cases are known gaps, not accepted variations of the standard.
module commonmark_links_test

import marksy
import marksy/html
import poke/should

test "CommonMark 482: Links" {
  let source = "[link](/uri \"title\")\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"/uri\" title=\"title\">link</a></p>\n")
}

test "CommonMark 483: Links" {
  let source = "[link](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"/uri\">link</a></p>\n")
}

test "CommonMark 484: Links" {
  let source = "[](./target.md)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"./target.md\"></a></p>\n")
}

