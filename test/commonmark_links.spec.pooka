test "CommonMark 504: Links" {
  let source = "[link](\"title\")\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"%22title%22\">link</a></p>\n")
}

test "CommonMark 505: Links" {
  let source = "[link](/url \"title\")\n[link](/url 'title')\n[link](/url (title))\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a></p>\n"
  )
}

test "CommonMark 506: Links" {
  let source = "[link](/url \"title \\\"&quot;\")\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"/url\" title=\"title &quot;&quot;\">link</a></p>\n"
  )
}

test "CommonMark 507: Links" {
  let source = "[link](/url \"title\")\n"
  let actual = marksy.parse(source) |> html.render_with(
