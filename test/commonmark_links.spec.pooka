  )
  should.equal(actual, "<p>[link <a href=\"/uri\">bar</a></p>\n")
}

test "CommonMark 515: Links" {
  let source = "[link \\[bar](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"/uri\">link [bar</a></p>\n")
}

test "CommonMark 516: Links" {
  let source = "[link *foo **bar** `#`*](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n"
  )
}

test "CommonMark 517: Links" {
  let source = "[![moon](moon.jpg)](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a></p>\n"
  )
}

test "CommonMark 518: Links" {
  let source = "[foo [bar](/uri)](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n")
}

test "CommonMark 519: Links" {
  let source = "[foo *[bar [baz](/uri)](/uri)*](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p>[foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>\n"
  )
}

test "CommonMark 520: Links" {
  let source = "![[[foo](uri1)](uri2)](uri3)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><img src=\"uri3\" alt=\"[foo](uri2)\" /></p>\n")
}

test "CommonMark 521: Links" {
  let source = "*[foo*](/uri)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>*<a href=\"/uri\">foo*</a></p>\n")
}

test "CommonMark 522: Links" {
  let source = "[foo *bar](baz*)\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"baz*\">foo *bar</a></p>\n")
}

test "CommonMark 523: Links" {
  let source = "*foo [bar* baz]\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><em>foo [bar</em> baz]</p>\n")
}

test "CommonMark 524: Links" {
  let source = "[foo <bar attr=\"](baz)\">\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>[foo <bar attr=\"](baz)\"></p>\n")
}

test "CommonMark 525: Links" {
  let source = "[foo`](/uri)`\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>[foo<code>](/uri)</code></p>\n")
}

test "CommonMark 526: Links" {
  let source = "[foo<https://example.com/?search=](uri)>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p>[foo<a href=\"https://example.com/?search=%5D(uri)\">https://example.com/?search=](uri)</a></p>\n"
  )
}

test "CommonMark 527: Links" {
