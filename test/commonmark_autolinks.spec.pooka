// Cases from CommonMark 0.31.2. The upstream expected HTML is unchanged.
// Skipped cases are known gaps, not accepted variations of the standard.
module commonmark_autolinks_test

import marksy
import marksy/html
import poke/should

test "CommonMark 594: Autolinks" {
  let source = "<http://foo.bar.baz>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"http://foo.bar.baz\">http://foo.bar.baz</a></p>\n"
  )
}

test "CommonMark 595: Autolinks" {
  let source = "<https://foo.bar.baz/test?q=hello&id=22&boolean>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean\">https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean</a></p>\n"
  )
}

test "CommonMark 596: Autolinks" {
  let source = "<irc://foo.bar:2233/baz>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"irc://foo.bar:2233/baz\">irc://foo.bar:2233/baz</a></p>\n"
  )
}

test "CommonMark 597: Autolinks" {
  let source = "<MAILTO:FOO@BAR.BAZ>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"MAILTO:FOO@BAR.BAZ\">MAILTO:FOO@BAR.BAZ</a></p>\n"
  )
}

test "CommonMark 598: Autolinks" {
  let source = "<a+b+c:d>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"a+b+c:d\">a+b+c:d</a></p>\n")
}

test "CommonMark 599: Autolinks" {
  let source = "<made-up-scheme://foo,bar>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"made-up-scheme://foo,bar\">made-up-scheme://foo,bar</a></p>\n"
  )
}

test "CommonMark 600: Autolinks" {
  let source = "<https://../>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><a href=\"https://../\">https://../</a></p>\n")
}

test "CommonMark 601: Autolinks" {
  let source = "<localhost:5001/foo>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"localhost:5001/foo\">localhost:5001/foo</a></p>\n"
  )
}

test "CommonMark 602: Autolinks" {
  let source = "<https://foo.bar/baz bim>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>&lt;https://foo.bar/baz bim&gt;</p>\n")
}

test "CommonMark 603: Autolinks" {
  let source = "<https://example.com/\\[\\>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"https://example.com/%5C%5B%5C\">https://example.com/\\[\\</a></p>\n"
  )
}

test "CommonMark 604: Autolinks" {
  let source = "<foo@bar.example.com>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a></p>\n"
  )
}

test "CommonMark 605: Autolinks" {
  let source = "<foo+special@Bar.baz-bar0.com>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p><a href=\"mailto:foo+special@Bar.baz-bar0.com\">foo+special@Bar.baz-bar0.com</a></p>\n"
  )
}

test "CommonMark 606: Autolinks" {
  let source = "<foo\\+@bar.example.com>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>&lt;foo+@bar.example.com&gt;</p>\n")
}

test "CommonMark 607: Autolinks" {
  let source = "<>\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>&lt;&gt;</p>\n")
}

test "CommonMark 608: Autolinks" {
  let source = "< https://foo.bar >\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>&lt; https://foo.bar &gt;</p>\n")
}

test "CommonMark 609: Autolinks" {
  let source = "<m:abc>\n"
  let actual = marksy.parse(source) |> html.render_with(
