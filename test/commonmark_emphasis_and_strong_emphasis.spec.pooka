// SPDX-License-Identifier: CC-BY-SA-4.0

// Cases from CommonMark 0.31.2. The upstream expected HTML is unchanged.
// Skipped cases are known gaps, not accepted variations of the standard.
module commonmark_emphasis_and_strong_emphasis_test

import marksy
import marksy/html
import poke/should

test "CommonMark 350: Emphasis and strong emphasis" {
  let source = "*foo bar*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p><em>foo bar</em></p>\n")
}

test "CommonMark 351: Emphasis and strong emphasis" {
  let source = "a * foo bar*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>a * foo bar*</p>\n")
}

test "CommonMark 352: Emphasis and strong emphasis" {
  let source = "a*\"foo\"*\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>a*&quot;foo&quot;*</p>\n")
}

test "CommonMark 353: Emphasis and strong emphasis" {
  let source = "* a *\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(actual, "<p>* a *</p>\n")
}

test "CommonMark 354: Emphasis and strong emphasis" {
  let source = "*$*alpha.\n\n*£*bravo.\n\n*€*charlie.\n"
  let actual = marksy.parse(source) |> html.render_with(
    html.Options(html.RawHtml.Preserve, True)
  )
  should.equal(
    actual,
    "<p>*$*alpha.</p>\n<p>*£*bravo.</p>\n<p>*€*charlie.</p>\n"
  )
}

test "CommonMark 355: Emphasis and strong emphasis" {
